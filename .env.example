# ---- LLM (optional: without a key the deterministic mock provider is used) ----
ANTHROPIC_API_KEY=
LLM_PROVIDER=                 # "anthropic" | "mock" (default: anthropic if a key is set, else mock)
AGENT_MODEL=claude-sonnet-5-5 # main agent model
CLASSIFIER_MODEL=claude-haiku-5-5   # cheaper model for classification and reranking
JUDGE_MODEL=                  # LLM-as-judge for `pnpm eval --judge` (defaults to AGENT_MODEL)
MODEL_PRICES_JSON=            # override assumed prices, e.g. {"claude-sonnet-5-5":{"in":3,"out":15}} (USD per million tokens)

# ---- Embeddings (optional: enables the vector legs of hybrid retrieval) ----
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_URL=           # OpenAI-compatible endpoint (default https://api.openai.com/v1/embeddings)
EMBEDDINGS_MODEL=             # default text-embedding-3-small

# ---- Retrieval (defaults were chosen on the dev split, see README) ----
RETRIEVAL_CHUNKER=structure   # fixed | structure
RETRIEVAL_MODE=hybrid         # keyword | hybrid
RETRIEVAL_RERANK=heuristic    # none | heuristic | llm
RETRIEVAL_TOP_K=4
MIN_RETRIEVAL_CONFIDENCE=0.5  # below this on a doc-grounded question the agent says "I don't know" and escalates

# ---- Database (optional: without it an embedded Postgres (PGlite) is used in .data/pglite) ----
DATABASE_URL=                 # Supabase/Postgres connection string
PGLITE_DIR=.data/pglite       # or :memory:
AUTO_SEED=1                   # seed + ingest on first start when the database is empty
NEXT_PUBLIC_SUPABASE_URL=     # enables Supabase Auth for admin login
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Security (CHANGE ALL IN PRODUCTION) ----
MCP_TOKEN_SECRET=dev-only-token-secret-change-me     # signs MCP bearer tokens, approval tokens and admin session cookies
WEBHOOK_SECRET=dev-only-webhook-secret               # HMAC secret for /api/webhooks/inbound
ENCRYPTION_KEY=dev-only-encryption-key-change-me     # encrypts OAuth refresh tokens at rest
ADMIN_PASSWORD=admin                                 # local admin login when Supabase Auth is not configured
CRON_SECRET=                                         # lets Vercel Cron call /api/worker/tick

# ---- Agent limits ----
APPROVAL_VALUE_THRESHOLD=50   # any monetary action above this needs approval (refunds always do)
MAX_AGENT_STEPS=8
MAX_TOKENS_PER_REQUEST=40000
BUSINESS_NOW=                 # fixed "today" for the fictional shop (default 2026-11-10T12:00:00Z) so return windows are deterministic

# ---- Public demo ----
DEMO_MODE=0                   # 1 = visitors are read-only except the simulate box
DEMO_RATE_LIMIT_PER_HOUR=20   # per IP, simulate endpoint
DEMO_DAILY_COST_CAP_USD=2     # simulate refuses once today's LLM spend reaches this
DEMO_DAILY_REQUEST_CAP=500

# ---- Integrations (each has a mock mode when unset) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
SLACK_WEBHOOK_URL=

# ---- Testing only ----
FAULT_INJECTION=0             # 1 enables the MCP server's fault injector (always on when NODE_ENV=test). NEVER set in production.
MOCK_GULLIBLE=0               # mock LLM obeys injected instructions (proves the gates hold)
